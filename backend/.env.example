# Copy to backend/.env (or export in your process manager) for production.

# Port the API/site binds to. Never 8000 on the shared VM (portfolio uses it).
PORT=8090

# Where the SQLite DB (fan votes + official results) lives. Default: backend/wc26.db
# WC_DB_PATH=/var/lib/wc26/wc26.db

# Enable continual-learning writes (POST/DELETE /api/admin/result). Unset = disabled (403).
# WC_ADMIN_TOKEN=change-me-to-a-long-random-string

# Monte-Carlo tuning (lower = faster/cheaper on small VMs).
# WC_MC_SIMS=4000          # base (cached) payload
# WC_MC_SIMS_TUNE=1500     # live squad/bias recomputes
# WC_MAX_COMPUTE=4         # max concurrent heavy recomputes

# Live football news. The backend proxies NewsAPI server-side, so the key is NEVER exposed to the
# browser. Put the real key in backend/.env (gitignored) as WC_NEWS_API_KEY. Without it (or on any
# fetch error) the rail and match cards fall back to the curated WC-2026 seed, so the app never breaks.
# WC_NEWS_API_KEY=your_newsapi_org_key_here
# WC_NEWS_TTL=1800
# Optional extra RSS/Atom feed merged in front of NewsAPI. Unset = NewsAPI + curated seed only.
# WC_NEWS_FEED=https://example.com/football.rss
