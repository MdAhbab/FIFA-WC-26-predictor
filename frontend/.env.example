# Copy to ".env" and fill in to enable Google AdSense (ad slots show placeholders until set).
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# VITE_AD_SLOT_LEADERBOARD=1234567890
# VITE_AD_SLOT_RECTANGLE=2345678901
# VITE_AD_SLOT_IN_ARTICLE=3456789012

# Optional: only if the API runs on a different origin than the site (default same-origin /api).
# VITE_API_BASE=https://api.example.com/api
# Optional dev override for the Vite proxy target (default http://127.0.0.1:8000).
# VITE_API_TARGET=http://127.0.0.1:8000
